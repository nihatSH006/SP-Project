# ---------------------------------------------------------------------------
# SOCAR SASIS — environment
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit it.
# ---------------------------------------------------------------------------

# --- Web SDK config (Firebase console -> Project settings -> Your apps) ------
# These are public by design: Firebase identifies the project with them, it does
# not authenticate with them. Access is gated by Auth + firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Admin credentials (server only) ----------------------------------------
# SECRET. The service-account JSON on one line, from
# Project settings -> Service accounts -> Generate new private key.
# Leave empty when running against the emulators, or when the host provides
# Application Default Credentials (Cloud Run, App Hosting, GCE).
FIREBASE_SERVICE_ACCOUNT=

# --- Escalation notifications (optional) -------------------------------------
# When set, a HIGH case that passes its deadline sends a Telegram message to
# head office (in addition to the timeline record, which is always written).
# Create a bot with @BotFather; the chat id is the group/user to notify.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: absolute URL of this app, appended to the message as a link.
APP_URL=

# --- Local emulator mode -----------------------------------------------------
# Uncomment all four to run entirely offline with no real Firebase project.
# The project id can be any value as long as it matches .firebaserc.
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=socar-sasis
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
