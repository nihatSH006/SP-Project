{
  "name": "socar-petrolium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "create-user": "tsx --conditions=react-server --env-file=.env.local scripts/create-user.ts",
    "emulators": "firebase emulators:start --only auth,firestore",
    "dev:emulated": "firebase emulators:exec --only auth,firestore \"next dev\"",
    "rules:test": "firebase emulators:exec --only firestore \"tsx scripts/verify-rules.ts\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "verify:analytics": "tsx scripts/verify-analytics.ts",
    "dev:turbopack": "next dev",
    "rules:verify": "tsx --conditions=react-server --env-file=.env.local scripts/verify-rules-live.ts",
    "build:turbopack": "next build",
    "seed-users": "tsx --conditions=react-server --env-file=.env.local scripts/seed-users.ts",
    "set-setting": "tsx --conditions=react-server --env-file=.env.local scripts/set-setting.ts",
    "verify:import": "tsx scripts/verify-import-validation.ts",
    "verify:fraud": "tsx scripts/verify-fraud-rules.ts",
    "verify:cases": "tsx --conditions=react-server --env-file=.env.local scripts/verify-cases-live.ts",
    "verify:fair": "tsx scripts/verify-scorecards.ts",
    "verify:fair-live": "tsx --conditions=react-server --env-file=.env.local scripts/verify-fair-live.ts",
    "verify:staffing": "tsx scripts/verify-staffing.ts",
    "verify:staffing-live": "tsx --conditions=react-server --env-file=.env.local scripts/verify-staffing-live.ts",
    "verify:board": "tsx --conditions=react-server --env-file=.env.local scripts/verify-board-pack.ts",
    "verify:nav": "tsx --conditions=react-server --env-file=.env.local scripts/verify-navigation.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tabler/icons-react": "^3.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "input-otp": "^1.4.2",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "firebase-tools": "^15.24.0",
    "puppeteer-core": "^25.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
